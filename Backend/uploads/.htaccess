# Uploaded images may be viewed, but never executed as scripts.
Require all granted
Options -Indexes -ExecCGI

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
